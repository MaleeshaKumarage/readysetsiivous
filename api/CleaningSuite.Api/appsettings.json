{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=cleaning;Username=cleaning_runtime;Password=configure-via-environment"
  },
  "Marten": {
    "AutoCreateSchemaMode": "None"
  },
  "Auth": {
    "Keycloak": {
      "ServerUrl": "http://localhost:8081",
      "Audience": "cleaning-suite-api",
      "PlatformAudience": "cleaning-suite-platform-api",
      "ProvisionerRealm": "master",
      "ProvisionerClientId": "cleaning-provisioner",
      "ProvisionerClientSecret": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://readysetsiivous.fi"
    ]
  },
  "EmployeeInvites": {
    "LifespanSeconds": 86400
  }
