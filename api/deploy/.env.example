# Copy to /home/ubuntu/cleaning-suite/.env on the production Oracle VM. Never commit real values.
POSTGRES_PASSWORD=change_me_postgres
KC_DB_PASSWORD=change_me_keycloak_db
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_admin
PROVISIONER_CLIENT_SECRET=change_me_provisioner
IMAGE_TAG=latest

# Existing realm SMTP is preserved; these settings initialize an empty SMTP config.
# Example using the same Resend provider; put the real key only in the host .env.
RESEND_API_KEY=
INVITE_SMTP_HOST=smtp.resend.com
INVITE_SMTP_PORT=587
INVITE_SMTP_FROM=noreply@readysetsiivous.fi
INVITE_SMTP_USER=resend
INVITE_SMTP_USE_RESEND_API_KEY=true
INVITE_SMTP_AUTH=true
INVITE_SMTP_STARTTLS=true
INVITE_SMTP_SSL=false
INVITE_SMTP_PASSWORD=
