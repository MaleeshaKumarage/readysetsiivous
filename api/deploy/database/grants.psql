BEGIN;
REVOKE ALL ON SCHEMA public FROM PUBLIC;
REVOKE ALL ON SCHEMA public FROM cleaning_runtime;
GRANT USAGE, CREATE ON SCHEMA public TO cleaning_owner;
GRANT USAGE ON SCHEMA public TO cleaning_runtime;
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM PUBLIC;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM PUBLIC;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA public FROM PUBLIC;
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM cleaning_runtime;
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM cleaning_runtime;
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA public FROM cleaning_runtime;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO cleaning_runtime;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO cleaning_runtime;
GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner REVOKE ALL ON TABLES FROM PUBLIC, cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner REVOKE ALL ON SEQUENCES FROM PUBLIC, cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner REVOKE ALL ON FUNCTIONS FROM cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner IN SCHEMA public REVOKE ALL ON TABLES FROM PUBLIC, cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner IN SCHEMA public REVOKE ALL ON SEQUENCES FROM PUBLIC, cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner IN SCHEMA public REVOKE ALL ON FUNCTIONS FROM PUBLIC, cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO cleaning_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR ROLE cleaning_owner IN SCHEMA public GRANT EXECUTE ON FUNCTIONS TO cleaning_runtime;
COMMIT;
