# Dev env (repo root). Copy to .env. Never commit .env.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=cleaning;Username=cleaning;Password=cleaning_dev
Marten__AutoCreateSchemaMode=CreateOrUpdate
Auth__Keycloak__ServerUrl=http://localhost:8081
Auth__Keycloak__Audience=cleaning-suite-api
Auth__Keycloak__PlatformAudience=cleaning-suite-platform-api
Auth__Keycloak__ProvisionerRealm=master
Auth__Keycloak__ProvisionerClientId=cleaning-provisioner
Auth__Keycloak__ProvisionerClientSecret=
# Dev-only master admin fallback (start-dev Keycloak). Matches dev/.env values.
Auth__Keycloak__AdminUser=admin
Auth__Keycloak__AdminPassword=change_me
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=https://readysetsiivous.fi

# Invitation URLs are explicit; never fall back to production for local invites.
App__FrontendBaseUrl=http://localhost:3000
# Optional internal transport; ServerUrl remains the public issuer/browser URL.
Auth__Keycloak__AdminServerUrl=http://localhost:8081
EmployeeInvites__LifespanSeconds=86400
# Configure realm SMTP directly, or use these to initialize an empty realm SMTP config.
EmployeeInvites__Smtp__Host=
EmployeeInvites__Smtp__From=
EmployeeInvites__Smtp__Port=587
EmployeeInvites__Smtp__Auth=true
EmployeeInvites__Smtp__User=
EmployeeInvites__Smtp__Password=
EmployeeInvites__Smtp__StartTls=true
EmployeeInvites__Smtp__Ssl=false
EmployeeInvites__Smtp__UseResendApiKey=false
